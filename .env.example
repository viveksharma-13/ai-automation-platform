# Application
APP_NAME=AI Automation Platform
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Security — generate strong random values before running
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Credential encryption — Fernet key (32 url-safe base64-encoded bytes)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key

# Database
DATABASE_URL=postgresql+psycopg://aip:aip@localhost:5432/ai_automation
# Tests may override with sqlite+pysqlite:///:memory:

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# OpenAI (optional until LLM nodes run)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
